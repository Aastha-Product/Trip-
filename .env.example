# Copy to .env.local and fill in.
# Leave the Supabase vars empty to use the local dev store (.data/db.json).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI: OpenAI is used first when set; Gemini is the fallback (e.g. if OpenAI is out of credits).
# At least one is needed for trip recommendations.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
